# Copy to deploy/env/homelab.env and edit.
POKER_VERSION=dev
SITE_ADDRESS=table.home.lan      # the name clients use; must resolve on your LAN
CADDY_TLS=internal               # "internal" = Caddy's private CA, or an email for Let's Encrypt
POKER_SIM=0                      # 1 = built-in simulated sensors (demo)
POKER_ALLOWED_ORIGINS=https://table.home.lan
POKER_API_TOKEN=                 # set a long random value, e.g. `openssl rand -hex 24`
